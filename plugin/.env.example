# rungud-cms plugin configuration.
# Preferred: define these as constants in wp-config.php. Environment variables are the fallback.
# Never commit real values. Staging uses Stripe TEST keys only.

# JWT signing secret for /wp-json/rungud/v1/auth/* — at least 32 random bytes.
RUNGUD_JWT_SECRET=

# Comma-separated list of allowed frontend origins (Vercel prod + preview domains).
RUNGUD_CORS_ORIGINS=https://rungud.vercel.app,http://localhost:5173

# Outgoing mail — same server and sender as the site so SPF/DKIM hold.
RUNGUD_SMTP_HOST=vega.mysafeservers.com
RUNGUD_SMTP_PORT=587
RUNGUD_SMTP_USER=
RUNGUD_SMTP_PASS=
RUNGUD_SMTP_FROM=info@inzentive.online
RUNGUD_SMTP_FROM_NAME=inZENtive

# Stripe restricted key: read invoices, cancel subscriptions, refund. rk_test_… on staging.
STRIPE_SECRET_KEY=
# Signing secret of the CMS's OWN webhook endpoint (/wp-json/rungud/v1/stripe), never LearnDash's.
STRIPE_WEBHOOK_SECRET=
